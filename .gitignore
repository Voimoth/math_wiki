# 临时/生成文件
node_modules/
*.log

# 编辑器
.vscode/
*.swp

# Obsidian 本地配置（app.json 已跟踪，保留共享配置）
.obsidian/

# 大文件：避免误提交把 .git 撑爆
# 教训：本仓库曾因误提交手机照片/截图/MP4/插件包，积累出 158MB 不可达孤儿对象，
#       需 git reflog expire + git gc --prune=now 才能回收。
*.mp4
*.mov
*.avi
*.mkv
*.flv
*.wmv
*.gif
*.zip
*.7z
*.rar
*.iso
*.exe
*.msi
*.dmg

# 大体积媒体（笔记需要插图时用 SVG 或压缩后的 PNG，不要放原始照片）
*.heic
*.raw


# Obsidian 自动生成的产物（反复出现，非笔记内容）
wikilinks.md

# 不要提交 OCR/提取副产物与其它非 vault 内容
*.txt
*.aux
*.log
